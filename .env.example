# Public canonical URL, replaced by the production domain after launch.
NEXT_PUBLIC_SITE_URL=https://theseoulvaleur.com
NEXT_PUBLIC_ENABLE_INDEXING=false

# Public browser configuration.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Pages Function secrets. Never expose these as NEXT_PUBLIC values.
TURNSTILE_SECRET_KEY=
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
FORM_SHARED_SECRET=
